{
  "$schema_comment": "Declarative Scanner Registry for disk-scanner-bench. To add a new program, append an entry to 'scanners' following 'addition_rule_schema'.",
  "addition_rule_schema": {
    "required_fields": [
      "id",
      "name",
      "version",
      "enabled",
      "runner_type",
      "platforms",
      "architectures",
      "size_metric",
      "command_template",
      "output_parser",
      "install"
    ],
    "runner_type_values": [
      "cli (Standard CLI or export-mode process monitored until exit by run_cli_scanners.py)",
      "win_gui (Pure Windows GUI program monitored via win_gui_monitor.ps1 until I/O + CPU settle)"
    ],
    "size_metric_values": [
      "allocated (Compares against ground_truth.allocated_size_bytes)",
      "apparent (Compares against ground_truth.apparent_size_bytes)"
    ],
    "template_placeholders": {
      "{bin}": "Resolved binary path or executable name",
      "{path}": "Mounted benchmark volume root path",
      "{export_file}": "Temporary export file path for CSV/JSON output"
    }
  },
  "mft_field_comment": "Optional 'mft' object (command_template using {volume} = volume root) marks scanners that can scan the raw NTFS $MFT; only those run in the MFT-only benchmark (benchmark-mft.yml).",
  "arm64_windows_comment": "The windows-11-arm job runs only scanners with a windows_aarch64 build (gdu, dua, dust, WinDirStat, SpaceKnife); x64-only tools (WizTree, SpaceSniffer, TreeSize, SquirrelDisk) are skipped instead of being timed under emulation.",
  "scanners": [
    {
      "id": "gdu",
      "name": "gdu",
      "version": "5.38.0",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["linux", "macos", "windows"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "allocated",
      "command_template": ["{bin}", "-n", "-p", "{path}"],
      "excludes_dir_blocks": ["linux"],
      "output_parser": "human_last_line",
      "install": {
        "linux_x86_64": "https://github.com/dundee/gdu/releases/download/v5.38.0/gdu_linux_amd64.tgz",
        "linux_aarch64": "https://github.com/dundee/gdu/releases/download/v5.38.0/gdu_linux_arm64.tgz",
        "macos_x86_64": "https://github.com/dundee/gdu/releases/download/v5.38.0/gdu_darwin_amd64.tgz",
        "macos_aarch64": "https://github.com/dundee/gdu/releases/download/v5.38.0/gdu_darwin_arm64.tgz",
        "windows_x86_64": "https://github.com/dundee/gdu/releases/download/v5.38.0/gdu_windows_amd64.exe.zip",
        "windows_aarch64": "https://github.com/dundee/gdu/releases/download/v5.38.0/gdu_windows_arm64.exe.zip"
      }
    },
    {
      "id": "dua",
      "name": "dua-cli",
      "version": "2.46.0",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["linux", "macos", "windows"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "allocated",
      "command_template": ["{bin}", "{path}"],
      "excludes_dir_blocks": ["windows"],
      "output_parser": "human_last_line",
      "install": {
        "linux_x86_64": "https://github.com/Byron/dua-cli/releases/download/v2.46.0/dua-v2.46.0-x86_64-unknown-linux-musl.tar.gz",
        "linux_aarch64": "https://github.com/Byron/dua-cli/releases/download/v2.46.0/dua-v2.46.0-aarch64-unknown-linux-musl.tar.gz",
        "macos_x86_64": "https://github.com/Byron/dua-cli/releases/download/v2.46.0/dua-v2.46.0-x86_64-apple-darwin.tar.gz",
        "macos_aarch64": "https://github.com/Byron/dua-cli/releases/download/v2.46.0/dua-v2.46.0-aarch64-apple-darwin.tar.gz",
        "windows_x86_64": "https://github.com/Byron/dua-cli/releases/download/v2.46.0/dua-v2.46.0-x86_64-pc-windows-msvc.zip",
        "windows_aarch64": "https://github.com/Byron/dua-cli/releases/download/v2.46.0/dua-v2.46.0-aarch64-pc-windows-msvc.zip"
      }
    },
    {
      "id": "dust",
      "name": "dust",
      "version": "1.2.6",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["linux", "macos", "windows"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "allocated",
      "command_template": ["{bin}", "-d", "1", "{path}"],
      "output_parser": "human_last_line",
      "install": {
        "linux_x86_64": "https://github.com/bootandy/dust/releases/download/v1.2.6/dust-v1.2.6-x86_64-unknown-linux-musl.tar.gz",
        "linux_aarch64": "https://github.com/bootandy/dust/releases/download/v1.2.6/dust-v1.2.6-aarch64-unknown-linux-musl.tar.gz",
        "macos_x86_64": "https://github.com/bootandy/dust/releases/download/v1.2.6/dust-v1.2.6-x86_64-apple-darwin.tar.gz",
        "macos_aarch64": "https://github.com/bootandy/dust/releases/download/v1.2.6/dust-v1.2.6-aarch64-apple-darwin.tar.gz",
        "windows_x86_64": "https://github.com/bootandy/dust/releases/download/v1.2.6/dust-v1.2.6-x86_64-pc-windows-msvc.zip",
        "windows_aarch64": "https://github.com/bootandy/dust/releases/download/v1.2.6/dust-v1.2.6-aarch64-pc-windows-msvc.zip"
      }
    },
    {
      "id": "ncdu",
      "name": "ncdu",
      "version": "2.9.2",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["linux", "macos"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "allocated",
      "command_template": ["{bin}", "-0", "-o", "/dev/null", "{path}"],
      "output_parser": "ncdu_null",
      "install": {
        "linux_x86_64": "https://dev.yorhel.nl/download/ncdu-2.9.2-linux-x86_64.tar.gz",
        "linux_aarch64": "https://dev.yorhel.nl/download/ncdu-2.9.2-linux-aarch64.tar.gz",
        "macos_x86_64": "brew:ncdu",
        "macos_aarch64": "brew:ncdu"
      }
    },
    {
      "id": "wiztree",
      "name": "WizTree64",
      "version": "4.33",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["windows"],
      "architectures": ["x86_64"],
      "size_metric": "apparent",
      "command_template": ["{bin}", "{path}", "/export={export_file}", "/exportfiles=0", "/admin=0"],
      "mft": {"command_template": ["{bin}", "{volume}", "/export={export_file}", "/exportfiles=0", "/admin=1"]},
      "output_parser": "wiztree_csv",
      "install": {
        "windows_x86_64": "https://www.diskanalyzer.com/files/wiztree_4_33_portable.zip"
      }
    },
    {
      "id": "spacesniffer",
      "name": "SpaceSniffer",
      "version": "2.2.0.27",
      "enabled": true,
      "runner_type": "win_gui",
      "platforms": ["windows"],
      "architectures": ["x86_64"],
      "size_metric": "apparent",
      "command_template": ["{bin}", "scan", "{path}"],
      "output_parser": "gui_monitor",
      "install": {
        "windows_x86_64": "https://www.uderzo.it/main_products/space_sniffer/files/spacesniffer_2_2_0_27_x64.zip"
      }
    },
    {
      "id": "windirstat",
      "name": "WinDirStat",
      "version": "2.9.3",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["windows"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "apparent",
      "command_template": ["{bin}", "/SaveTo", "{export_file}", "{path}"],
      "mft": {"command_template": ["{bin}", "/SaveTo", "{export_file}", "{volume}"]},
      "output_parser": "windirstat_csv",
      "install": {
        "windows_x86_64": "https://github.com/windirstat/windirstat/releases/download/release%2Fv2.9.3/WinDirStat.zip",
        "windows_aarch64": "https://github.com/windirstat/windirstat/releases/download/release%2Fv2.9.3/WinDirStat.zip"
      }
    },
    {
      "id": "treesize",
      "name": "TreeSizeFree",
      "version": "4.7.3",
      "enabled": false,
      "disabled_reason": "Not part of the benchmark: TreeSize Free is not licensed for Windows Server, so it never scans on the GitHub Windows runners",
      "runner_type": "win_gui",
      "platforms": ["windows"],
      "architectures": ["x86_64"],
      "size_metric": "apparent",
      "command_template": ["{bin}", "/NOADMIN", "{path}"],
      "mft": {"command_template": ["{bin}", "{volume}"]},
      "output_parser": "gui_monitor",
      "install": {
        "windows_x86_64": "https://downloads.jam-software.de/treesize_free/TreeSizeFree-Portable.zip"
      }
    },
    {
      "id": "spaceknife",
      "name": "spaceknife-backend",
      "version": "0.3.3 dev-38c3b73 (runs 40188287823, 40188287831)",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["linux", "macos", "windows"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "allocated",
      "command_template": ["{bin}", "scan", "{path}", "--no-snapshot", "--top", "5", "--depth", "1"],
      "mft": {
        "command_template": ["{bin}", "scan", "{volume}", "--mft", "--no-snapshot", "--top", "5", "--depth", "1"]
      },
      "output_parser": "spaceknife_cli",
      "install": {
        "linux_x86_64": "gh-artifact:DuskXi/SpaceKnife:40188287823:SpaceKnife-portable-linux-x64",
        "linux_aarch64": "gh-artifact:DuskXi/SpaceKnife:40188287823:SpaceKnife-portable-linux-arm64",
        "windows_x86_64": "gh-artifact:DuskXi/SpaceKnife:40188287823:SpaceKnife-portable-win-x64",
        "windows_aarch64": "gh-artifact:DuskXi/SpaceKnife:40188287823:SpaceKnife-portable-win-arm64",
        "macos_x86_64": "gh-artifact:DuskXi/SpaceKnife:40188287831:SpaceKnife-mac-x64",
        "macos_aarch64": "gh-artifact:DuskXi/SpaceKnife:40188287831:SpaceKnife-mac-arm64"
      }
    },
    {
      "id": "squirreldisk",
      "name": "squirreldisk",
      "version": "2.6.1",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["linux", "macos", "windows"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "allocated",
      "command_template": ["{bin}", "scan", "{path}", "--json", "--fresh", "--depth", "1", "--top", "5"],
      "output_parser": "squirreldisk_json",
      "runtime_packages": {"linux": ["libasound2t64", "libasound2"]},
      "install": {
        "linux_x86_64": "https://github.com/adileo/squirreldisk/releases/download/v2.6.1/squirreldisk-x86_64-unknown-linux-gnu",
        "macos_x86_64": "https://github.com/adileo/squirreldisk/releases/download/v2.6.1/squirreldisk-x86_64-apple-darwin",
        "macos_aarch64": "https://github.com/adileo/squirreldisk/releases/download/v2.6.1/squirreldisk-aarch64-apple-darwin",
        "windows_x86_64": "https://github.com/adileo/squirreldisk/releases/download/v2.6.1/squirreldisk-x86_64-pc-windows-msvc.exe"
      }
    }
  ]
}
