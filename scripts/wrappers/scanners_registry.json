{
  "$schema_comment": "Declarative Scanner Registry for disk-scanner-bench. To add a new program, append an entry to 'scanners' following 'addition_rule_schema'.",
  "addition_rule_schema": {
    "required_fields": ["id", "name", "version", "enabled", "runner_type", "platforms", "architectures", "size_metric", "command_template", "output_parser", "install"],
    "runner_type_values": ["cli (Standard CLI or export-mode process monitored until exit by run_cli_scanners.py)", "win_gui (Pure Windows GUI program monitored via win_gui_monitor.ps1 until I/O + CPU settle)"],
    "size_metric_values": ["allocated (Compares against ground_truth.allocated_size_bytes)", "apparent (Compares against ground_truth.apparent_size_bytes)"],
    "template_placeholders": {
      "{bin}": "Resolved binary path or executable name",
      "{path}": "Mounted benchmark volume root path",
      "{export_file}": "Temporary export file path for CSV/JSON output"
    }
  },
  "optional_fields_comment": {
    "apparent_on": "OS list where the scanner can only report logical sizes; it is then compared against the apparent ground truth",
    "excludes_dir_blocks": "OS list where the scanner does not count the blocks folders themselves occupy; its total and each top-level folder are then compared against the files-only allocation",
    "command_template_by_os": "Per-OS replacement for command_template",
    "bin_name": "Executable name when it differs from 'name' (e.g. erd for erdtree, du64 for Sysinternals du)",
    "display_name": "Name shown on the boards when 'name' is an executable name (spaceknife-backend -> SpaceKnife)",
    "notes / notes_en": "Short Chinese / English notes shown in the README scanner table",
    "exe_by_arch": "Which executable of a multi-architecture archive to use per architecture",
    "verify_command_template": "Untimed extra run whose output is used to check completeness, for tools whose timed command prints nothing (ncdu -o /dev/null)",
    "install specs": "URL of an archive or raw executable; gh-artifact:<repo>:<run>:<artifact>; system:<command or path>; cargo:<crate>@<version>:<binary>; brew:<formula>"
  },
  "mft_field_comment": "Optional 'mft' object (command_template using {volume} = volume root) marks scanners that can scan the raw NTFS $MFT; only those run in the MFT-only benchmark (benchmark-mft.yml).",
  "arm64_windows_comment": "The windows-11-arm job runs only scanners with a windows_aarch64 build (gdu, dua, dust, WinDirStat, SpaceKnife); x64-only tools (WizTree, SpaceSniffer, TreeSize, SquirrelDisk) are skipped instead of being timed under emulation.",
  "scanners": [
    {
      "id": "gdu",
      "name": "gdu",
      "version": "5.38.0",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["linux", "macos", "windows"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "allocated",
      "command_template": ["{bin}", "-n", "-p", "{path}"],
      "excludes_dir_blocks": ["linux"],
      "output_parser": "human_last_line",
      "install": {
        "linux_x86_64": "https://github.com/dundee/gdu/releases/download/v5.38.0/gdu_linux_amd64.tgz",
        "linux_aarch64": "https://github.com/dundee/gdu/releases/download/v5.38.0/gdu_linux_arm64.tgz",
        "macos_x86_64": "https://github.com/dundee/gdu/releases/download/v5.38.0/gdu_darwin_amd64.tgz",
        "macos_aarch64": "https://github.com/dundee/gdu/releases/download/v5.38.0/gdu_darwin_arm64.tgz",
        "windows_x86_64": "https://github.com/dundee/gdu/releases/download/v5.38.0/gdu_windows_amd64.exe.zip",
        "windows_aarch64": "https://github.com/dundee/gdu/releases/download/v5.38.0/gdu_windows_arm64.exe.zip"
      },
      "apparent_on": ["windows"]
    },
    {
      "id": "dua",
      "name": "dua-cli",
      "version": "2.46.0",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["linux", "macos", "windows"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "allocated",
      "command_template": ["{bin}", "{path}"],
      "excludes_dir_blocks": ["windows"],
      "output_parser": "human_last_line",
      "install": {
        "linux_x86_64": "https://github.com/Byron/dua-cli/releases/download/v2.46.0/dua-v2.46.0-x86_64-unknown-linux-musl.tar.gz",
        "linux_aarch64": "https://github.com/Byron/dua-cli/releases/download/v2.46.0/dua-v2.46.0-aarch64-unknown-linux-musl.tar.gz",
        "macos_x86_64": "https://github.com/Byron/dua-cli/releases/download/v2.46.0/dua-v2.46.0-x86_64-apple-darwin.tar.gz",
        "macos_aarch64": "https://github.com/Byron/dua-cli/releases/download/v2.46.0/dua-v2.46.0-aarch64-apple-darwin.tar.gz",
        "windows_x86_64": "https://github.com/Byron/dua-cli/releases/download/v2.46.0/dua-v2.46.0-x86_64-pc-windows-msvc.zip",
        "windows_aarch64": "https://github.com/Byron/dua-cli/releases/download/v2.46.0/dua-v2.46.0-aarch64-pc-windows-msvc.zip"
      }
    },
    {
      "id": "dust",
      "name": "dust",
      "version": "1.2.6",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["linux", "macos", "windows"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "allocated",
      "command_template": ["{bin}", "-d", "1", "{path}"],
      "output_parser": "human_last_line",
      "install": {
        "linux_x86_64": "https://github.com/bootandy/dust/releases/download/v1.2.6/dust-v1.2.6-x86_64-unknown-linux-musl.tar.gz",
        "linux_aarch64": "https://github.com/bootandy/dust/releases/download/v1.2.6/dust-v1.2.6-aarch64-unknown-linux-musl.tar.gz",
        "macos_x86_64": "https://github.com/bootandy/dust/releases/download/v1.2.6/dust-v1.2.6-x86_64-apple-darwin.tar.gz",
        "macos_aarch64": "https://github.com/bootandy/dust/releases/download/v1.2.6/dust-v1.2.6-aarch64-apple-darwin.tar.gz",
        "windows_x86_64": "https://github.com/bootandy/dust/releases/download/v1.2.6/dust-v1.2.6-x86_64-pc-windows-msvc.zip",
        "windows_aarch64": "https://github.com/bootandy/dust/releases/download/v1.2.6/dust-v1.2.6-aarch64-pc-windows-msvc.zip"
      },
      "apparent_on": ["windows"]
    },
    {
      "id": "ncdu",
      "name": "ncdu",
      "version": "2.9.2",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["linux", "macos"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "allocated",
      "command_template": ["{bin}", "-0", "-o", "/dev/null", "{path}"],
      "output_parser": "ncdu_null",
      "verify_command_template": ["{bin}", "-0", "-o", "{export_file}", "{path}"],
      "verify_parser": "ncdu_json",
      "install": {
        "linux_x86_64": "https://dev.yorhel.nl/download/ncdu-2.9.2-linux-x86_64.tar.gz",
        "linux_aarch64": "https://dev.yorhel.nl/download/ncdu-2.9.2-linux-aarch64.tar.gz",
        "macos_x86_64": "brew:ncdu",
        "macos_aarch64": "brew:ncdu"
      }
    },
    {
      "id": "wiztree",
      "name": "WizTree64",
      "display_name": "WizTree",
      "version": "4.33",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["windows"],
      "architectures": ["x86_64"],
      "size_metric": "apparent",
      "command_template": ["{bin}", "{path}", "/export={export_file}", "/exportfiles=0", "/admin=0"],
      "mft": {"command_template": ["{bin}", "{volume}", "/export={export_file}", "/exportfiles=0", "/admin=1"]},
      "output_parser": "wiztree_csv",
      "install": {"windows_x86_64": "https://www.diskanalyzer.com/files/wiztree_4_33_portable.zip"}
    },
    {
      "id": "spacesniffer",
      "name": "SpaceSniffer",
      "version": "2.2.0.27",
      "enabled": true,
      "runner_type": "win_gui",
      "platforms": ["windows"],
      "architectures": ["x86_64"],
      "size_metric": "apparent",
      "command_template": ["{bin}", "scan", "{path}"],
      "output_parser": "gui_monitor",
      "install": {
        "windows_x86_64": "https://www.uderzo.it/main_products/space_sniffer/files/spacesniffer_2_2_0_27_x64.zip"
      }
    },
    {
      "id": "windirstat",
      "name": "WinDirStat",
      "version": "2.9.3",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["windows"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "apparent",
      "command_template": ["{bin}", "/SaveTo", "{export_file}", "{path}"],
      "mft": {"command_template": ["{bin}", "/SaveTo", "{export_file}", "{volume}"]},
      "output_parser": "windirstat_csv",
      "install": {
        "windows_x86_64": "https://github.com/windirstat/windirstat/releases/download/release%2Fv2.9.3/WinDirStat.zip",
        "windows_aarch64": "https://github.com/windirstat/windirstat/releases/download/release%2Fv2.9.3/WinDirStat.zip"
      }
    },
    {
      "id": "treesize",
      "name": "TreeSizeFree",
      "version": "4.7.3",
      "enabled": false,
      "disabled_reason": "Not part of the benchmark: TreeSize Free is not licensed for Windows Server, so it never scans on the GitHub Windows runners",
      "runner_type": "win_gui",
      "platforms": ["windows"],
      "architectures": ["x86_64"],
      "size_metric": "apparent",
      "command_template": ["{bin}", "/NOADMIN", "{path}"],
      "mft": {"command_template": ["{bin}", "{volume}"]},
      "output_parser": "gui_monitor",
      "install": {"windows_x86_64": "https://downloads.jam-software.de/treesize_free/TreeSizeFree-Portable.zip"}
    },
    {
      "id": "spaceknife",
      "name": "spaceknife-backend",
      "display_name": "SpaceKnife",
      "version": "0.3.3 dev-38c3b73 (runs 40188287823, 40188287831)",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["linux", "macos", "windows"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "allocated",
      "command_template": ["{bin}", "scan", "{path}", "--no-snapshot", "--top", "5", "--depth", "1"],
      "mft": {
        "command_template": ["{bin}", "scan", "{volume}", "--mft", "--no-snapshot", "--top", "5", "--depth", "2"]
      },
      "output_parser": "spaceknife_cli",
      "install": {
        "linux_x86_64": "gh-artifact:DuskXi/SpaceKnife:40188287823:SpaceKnife-portable-linux-x64",
        "linux_aarch64": "gh-artifact:DuskXi/SpaceKnife:40188287823:SpaceKnife-portable-linux-arm64",
        "windows_x86_64": "gh-artifact:DuskXi/SpaceKnife:40188287823:SpaceKnife-portable-win-x64",
        "windows_aarch64": "gh-artifact:DuskXi/SpaceKnife:40188287823:SpaceKnife-portable-win-arm64",
        "macos_x86_64": "gh-artifact:DuskXi/SpaceKnife:40188287831:SpaceKnife-mac-x64",
        "macos_aarch64": "gh-artifact:DuskXi/SpaceKnife:40188287831:SpaceKnife-mac-arm64"
      }
    },
    {
      "id": "squirreldisk",
      "name": "squirreldisk",
      "display_name": "SquirrelDisk",
      "version": "2.6.1",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["linux", "macos", "windows"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "allocated",
      "command_template": ["{bin}", "scan", "{path}", "--json", "--fresh", "--depth", "1", "--top", "5"],
      "output_parser": "squirreldisk_json",
      "runtime_packages": {"linux": ["libasound2t64", "libasound2"]},
      "install": {
        "linux_x86_64": "https://github.com/adileo/squirreldisk/releases/download/v2.6.1/squirreldisk-x86_64-unknown-linux-gnu",
        "macos_x86_64": "https://github.com/adileo/squirreldisk/releases/download/v2.6.1/squirreldisk-x86_64-apple-darwin",
        "macos_aarch64": "https://github.com/adileo/squirreldisk/releases/download/v2.6.1/squirreldisk-aarch64-apple-darwin",
        "windows_x86_64": "https://github.com/adileo/squirreldisk/releases/download/v2.6.1/squirreldisk-x86_64-pc-windows-msvc.exe"
      }
    },
    {
      "id": "gnu-du",
      "name": "GNU du",
      "version": "coreutils 9.4 (ubuntu-24.04 image)",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["linux"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "allocated",
      "command_template": ["{bin}", "-B1", "-d", "1", "{path}"],
      "output_parser": "du_bytes",
      "notes": "系统基线：单线程，硬链接只算一次，计入目录块",
      "notes_en": "System baseline: single-threaded, hard links counted once, directory blocks included",
      "install": {"linux_x86_64": "system:du", "linux_aarch64": "system:du"}
    },
    {
      "id": "bsd-du",
      "name": "BSD du",
      "version": "macOS system /usr/bin/du",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["macos"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "allocated",
      "command_template": ["{bin}", "-k", "-d", "1", "{path}"],
      "output_parser": "du_kib",
      "notes": "系统基线：单线程，硬链接只算一次，精度为 KiB",
      "notes_en": "System baseline: single-threaded, hard links counted once, KiB granularity",
      "install": {"macos_x86_64": "system:/usr/bin/du", "macos_aarch64": "system:/usr/bin/du"}
    },
    {
      "id": "sysinternals-du",
      "name": "Sysinternals du",
      "bin_name": "du64",
      "version": "1.62",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["windows"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "allocated",
      "command_template": ["{bin}", "-accepteula", "-nobanner", "-c", "-l", "1", "{path}"],
      "output_parser": "sysinternals_du_csv",
      "exe_by_arch": {"x86_64": "du64.exe", "aarch64": "du64a.exe"},
      "notes": "微软 Sysinternals 出品；单线程；CSV 同时给出大小和实际占用",
      "notes_en": "Microsoft Sysinternals; single-threaded; its CSV gives both size and size on disk",
      "install": {
        "windows_x86_64": "https://download.sysinternals.com/files/DU.zip",
        "windows_aarch64": "https://download.sysinternals.com/files/DU.zip"
      }
    },
    {
      "id": "pdu",
      "name": "pdu",
      "version": "0.24.0",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["linux", "macos", "windows"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "allocated",
      "apparent_on": ["windows"],
      "command_template": ["{bin}", "--json-output", "--max-depth=2", "--min-ratio=0", "--threads=max", "-H", "-q", "block-size", "{path}"],
      "command_template_by_os": {
        "windows": ["{bin}", "--json-output", "--max-depth=2", "--min-ratio=0", "--threads=max", "-q", "apparent-size", "{path}"]
      },
      "output_parser": "pdu_json",
      "notes": "parallel-disk-usage；用 --threads=max，因为默认的 auto 把虚拟盘误判成机械盘时会降到 1 线程；硬链接去重（-H）和块大小只在 Unix 上有",
      "notes_en": "parallel-disk-usage; run with --threads=max because the default 'auto' drops to 1 thread on disks it takes for HDDs; hard-link dedupe (-H) and block sizes exist on Unix only",
      "install": {
        "linux_x86_64": "https://github.com/KSXGitHub/parallel-disk-usage/releases/download/0.24.0/pdu-x86_64-unknown-linux-musl",
        "linux_aarch64": "cargo:parallel-disk-usage@0.24.0:pdu",
        "macos_x86_64": "https://github.com/KSXGitHub/parallel-disk-usage/releases/download/0.24.0/pdu-x86_64-apple-darwin",
        "macos_aarch64": "cargo:parallel-disk-usage@0.24.0:pdu",
        "windows_x86_64": "https://github.com/KSXGitHub/parallel-disk-usage/releases/download/0.24.0/pdu-x86_64-pc-windows-msvc.exe",
        "windows_aarch64": "cargo:parallel-disk-usage@0.24.0:pdu"
      }
    },
    {
      "id": "diskus",
      "name": "diskus",
      "version": "0.9.0",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["linux", "macos", "windows"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "allocated",
      "apparent_on": ["windows"],
      "command_template": ["{bin}", "{path}"],
      "output_parser": "bare_integer",
      "notes": "只输出总大小；默认线程数为核数 × 3；Windows 版只报逻辑大小",
      "notes_en": "Prints only the total; 3 threads per core by default; the Windows build reports logical sizes",
      "install": {
        "linux_x86_64": "https://github.com/sharkdp/diskus/releases/download/v0.9.0/diskus-v0.9.0-x86_64-unknown-linux-musl.tar.gz",
        "linux_aarch64": "https://github.com/sharkdp/diskus/releases/download/v0.9.0/diskus-v0.9.0-aarch64-unknown-linux-gnu.tar.gz",
        "macos_x86_64": "https://github.com/sharkdp/diskus/releases/download/v0.9.0/diskus-v0.9.0-x86_64-apple-darwin.tar.gz",
        "macos_aarch64": "https://github.com/sharkdp/diskus/releases/download/v0.9.0/diskus-v0.9.0-aarch64-apple-darwin.tar.gz",
        "windows_x86_64": "https://github.com/sharkdp/diskus/releases/download/v0.9.0/diskus-v0.9.0-x86_64-pc-windows-msvc.zip",
        "windows_aarch64": "cargo:diskus@0.9.0:diskus"
      }
    },
    {
      "id": "erdtree",
      "name": "erdtree",
      "bin_name": "erd",
      "version": "3.1.2",
      "enabled": true,
      "runner_type": "cli",
      "platforms": ["linux", "macos", "windows"],
      "architectures": ["x86_64", "aarch64"],
      "size_metric": "allocated",
      "command_template": ["{bin}", "--no-config", "--no-progress", "-C", "none", "-.", "-i", "-d", "physical", "-y", "iflat", "-L", "1", "{path}"],
      "excludes_dir_blocks": ["linux"],
      "output_parser": "erdtree",
      "notes": "加 -. 和 -i 才会计入隐藏文件和被 .gitignore 忽略的文件；整棵树常驻内存",
      "notes_en": "-. and -i make it count hidden and git-ignored files; keeps the whole tree in memory",
      "install": {
        "linux_x86_64": "https://github.com/solidiquis/erdtree/releases/download/v3.1.2/erd-v3.1.2-x86_64-unknown-linux-musl.tar.gz",
        "linux_aarch64": "https://github.com/solidiquis/erdtree/releases/download/v3.1.2/erd-v3.1.2-aarch64-unknown-linux-musl.tar.gz",
        "macos_x86_64": "https://github.com/solidiquis/erdtree/releases/download/v3.1.2/erd-v3.1.2-x86_64-apple-darwin.tar.gz",
        "macos_aarch64": "https://github.com/solidiquis/erdtree/releases/download/v3.1.2/erd-v3.1.2-aarch64-apple-darwin.tar.gz",
        "windows_x86_64": "https://github.com/solidiquis/erdtree/releases/download/v3.1.2/erd-v3.1.2-x86_64-pc-windows-msvc.exe",
        "windows_aarch64": "cargo:erdtree@3.1.2:erd"
      }
    }
  ]
}
